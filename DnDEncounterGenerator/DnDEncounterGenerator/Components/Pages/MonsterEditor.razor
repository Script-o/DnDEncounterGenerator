@page "/MonsterEditor"

<PageTitle>Monsters</PageTitle>

@using Microsoft.EntityFrameworkCore

@rendermode InteractiveServer

@*@inject IDbContextFactory<MonsterContext> MonsterContextFactory;*@

@if (@ShowCreate)
{

    <h3>Add a New Monster</h3>
    <div class="row">
        <label for="Name" class="col-4 col-form-label">Monster Name</label>
        <div class="col-8">
            <input id="Name" name="Name" type="text" class="form-control" @bind="@NewMonster.Name">
        </div>
    </div>
    <div class="row">
        <label for="ArmorClass" class="col-4 col-form-label">Armor Class</label>
        <div class="col-8">
            <input id="ArmorClass" name="ArmorClass" type="text" class="form-control" @bind="@NewMonster.ArmorClass">
        </div>
    </div>
    <div class="row">
        <label for="Health" class="col-4 col-form-label">Health</label>
        <div class="col-8">
            <input id="Health" name="Health" type="text" class="form-control" @bind="@NewMonster.HitPoints">
        </div>
    </div>
    <div class="row">
        <label for="Speed" class="col-4 col-form-label">Speed</label>
        <div class="col-8">
            <input id="Speed" name="Speed" type="text" class="form-control" @bind="@NewMonster.Speed">
        </div>
    </div>
    <div class="row">
        <label for="Strength" class="col-4 col-form-label">Strength</label>
        <div class="col-8">
            <input id="Strength" name="Strength" type="text" class="form-control" @bind="@NewMonster.Strength">
        </div>
    </div>
    <div class="row">
        <label for="Dexterity" class="col-4 col-form-label">Dexterity</label>
        <div class="col-8">
            <input id="Dexterity" name="Dexterity" type="text" class="form-control" @bind="@NewMonster.Dexterity">
        </div>
    </div>
    <div class="row">
        <label for="Constitution" class="col-4 col-form-label">Constitution</label>
        <div class="col-8">
            <input id="Constitution" name="Constitution" type="text" class="form-control" @bind="@NewMonster.Constitution">
        </div>
    </div>
    <div class="row">
        <label for="Intelligence" class="col-4 col-form-label">Intelligence</label>
        <div class="col-8">
            <input id="Intelligence" name="Intelligence" type="text" class="form-control" @bind="@NewMonster.Intelligence">
        </div>
    </div>
    <div class="row">
        <label for="Wisdom" class="col-4 col-form-label">Wisdom</label>
        <div class="col-8">
            <input id="Wisdom" name="Wisdom" type="text" class="form-control" @bind="@NewMonster.Wisdom">
        </div>
    </div>
    <div class="row">
        <label for="Charisma" class="col-4 col-form-label">Charisma</label>
        <div class="col-8">
            <input id="Charisma" name="Charisma" type="text" class="form-control" @bind="@NewMonster.Charisma">
        </div>
    </div>
    <div class="row">
        <label for="ChallengeRating" class="col-4 col-form-label">Challenge Rating</label>
        <div class="col-8">
            <input id="ChallengeRating" name="ChallengeRating" type="text" class="form-control" @bind="@NewMonster.ChallengeRating">
        </div>
    </div>
    <div class="form-group row">
        <div class="offset-4 col-8">
            <button name="submit" type="submit" class="btn btn-primary" @onclick="CreateNewMonster">Submit</button>
        </div>
    </div>

}
else
{
    <div class="form-group row">
        <div class="offset-4 col-8">
            <button name="submit" type="submit" class="btn btn-primary" @onclick="ShowCreateForm">Add a New Monster</button>
        </div>
    </div>

    @if (@OurMonsters is not null && @OurMonsters.Count > 0)
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover table-bordered table-light border-dark">
                <thead>
                    <tr>
                        <th scope="col">Name</th>
                        <th scope="col">AC</th>
                        <th scope="col">HP</th>
                        <th scope="col">Speed</th>
                        <th scope="col">STR</th>
                        <th scope="col">DEX</th>
                        <th scope="col">CON</th>
                        <th scope="col">INT</th>
                        <th scope="col">WIS</th>
                        <th scope="col">CHA</th>
                        <th scope="col">CR</th>

                        @* @for(int i=1; i < ListOfAttributes.Count; i++)
                        {
                            <th scope="col">@ListOfAttributes[i]</th>
                        } *@

                        <th scope="col">Edit</th>
                        <th scope="col">Delete</th>
                    </tr>
                </thead>
                <tbody>

                    @foreach (var monster in @OurMonsters)
                    {
                        @if (!@EditRecord)
                        {
                            <tr>
                                <td>@monster.Name</td>
                                <td>@monster.ArmorClass</td>
                                <td>@monster.HitPoints</td>
                                <td>@monster.Speed ft</td>
                                <td>@monster.Strength</td>
                                <td>@monster.Dexterity</td>
                                <td>@monster.Constitution</td>
                                <td>@monster.Intelligence</td>
                                <td>@monster.Wisdom</td>
                                <td>@monster.Charisma</td>
                                <td>@monster.ChallengeRating</td>

                                <td> <button name="submit" type="submit" class="btn btn-primary" @onclick="() => ShowEditForm(monster)">Edit</button></td>
                                <td> <button name="submit" type="submit" class="btn btn-primary" @onclick="() => DeleteMonster(monster)">Delete</button></td>
                            </tr>
                        }
                        else
                        {
                            if (@MonsterToUpdate is not null && @MonsterToUpdate.MonsterId == @monster.MonsterId)
                            {
                                <tr>
                                    <td><input id="Name" name="Name" type="text" class="form-control" @bind="@MonsterToUpdate.Name" /></td>
                                    <td><input id="ArmorClass" name="ArmorClass" type="text" class="form-control" @bind="@MonsterToUpdate.ArmorClass" /></td>
                                    <td><input id="HitPoints" name="HitPoints" type="text" class="form-control" @bind="@MonsterToUpdate.HitPoints" /></td>
                                    <td><input id="Speed" name="Speed" type="text" class="form-control" @bind="@MonsterToUpdate.Speed" /></td>
                                    <td><input id="Strength" name="Strength" type="text" class="form-control" @bind="@MonsterToUpdate.Strength" /></td>
                                    <td><input id="Dexterity" name="Dexterity" type="text" class="form-control" @bind="@MonsterToUpdate.Dexterity" /></td>
                                    <td><input id="Constitution" name="Constitution" type="text" class="form-control" @bind="@MonsterToUpdate.Constitution" /></td>
                                    <td><input id="Intelligence" name="Intelligence" type="text" class="form-control" @bind="@MonsterToUpdate.Intelligence" /></td>
                                    <td><input id="Wisdom" name="Wisdom" type="text" class="form-control" @bind="@MonsterToUpdate.Wisdom" /></td>
                                    <td><input id="Charisma" name="Charisma" type="text" class="form-control" @bind="@MonsterToUpdate.Charisma" /></td>
                                    <td><input id="ChallengeRating" name="ChallengeRating" type="text" class="form-control" @bind="@MonsterToUpdate.ChallengeRating" /></td>
                                    <td> <button name="submit" type="submit" class="btn btn-primary" @onclick="@UpdateMonster">Save</button></td>
                                    <td></td>
                                </tr>
                            }
                            else
                            {
                                <tr>
                                    <td>@monster.Name</td>
                                    <td>@monster.ArmorClass</td>
                                    <td>@monster.HitPoints</td>
                                    <td>@monster.Speed</td>
                                    <td>@monster.Strength</td>
                                    <td>@monster.Dexterity</td>
                                    <td>@monster.Constitution</td>
                                    <td>@monster.Intelligence</td>
                                    <td>@monster.Wisdom</td>
                                    <td>@monster.Charisma</td>
                                    <td>@monster.ChallengeRating</td>
                                    <td> <button name="submit" type="submit" class="btn btn-primary" @onclick="() => ShowEditForm(monster)">Edit</button></td>
                                    <td> <button name="submit" type="submit" class="btn btn-primary" @onclick="() => DeleteMonster(monster)">Delete</button></td>
                                </tr>
                            }
                        }
                    }
                </tbody>
            </table>
        </div>
    }
}